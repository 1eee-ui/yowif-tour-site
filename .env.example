# Copy this file to .env and set your own password (at least 10 characters).
# The server will not start with an empty or default password.
ADMIN_PASSWORD=
PORT=3000

# Optional: ticket e-mails via resend.com. Without it the site works,
# but no e-mails are sent.
RESEND_API_KEY=
# Sender address. Leave empty to use Resend's test sender
# (then e-mails only reach the Resend account owner's own address).
MAIL_FROM=
